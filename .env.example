# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role (server-only - for updating user metadata)
# Found in Supabase Dashboard → Settings → API → Legacy keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter (optional - for AI meal suggestions)
OPENROUTER_API_KEY=your-openrouter-api-key

# Google OAuth (required for Google login, optional for calendar sync)
# Used for both Google Sign-In and Google Calendar integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Cloud Console - Authorized redirect URIs (add both):
# 1. Google Login: https://your-domain.com/api/auth/google/callback
# 2. Calendar sync: https://your-domain.com/api/calendar/callback
# For local dev, also add:
# 1. http://localhost:3000/api/auth/google/callback
# 2. http://localhost:3000/api/calendar/callback

# Calendar-specific redirect (only needed if using calendar sync)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Token Encryption (set in Supabase database, not env file)
# Run in Supabase SQL editor for production:
# INSERT INTO app_settings (key, value) VALUES ('encryption_key', 'your-32-character-secret-key-here');

# Vercel Cron (required for scheduled Spond sync)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-for-vercel
