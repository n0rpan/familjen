# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Admin (server-only - email with full admin access to /admin page)
# This email must also have is_admin=true in the allowed_emails table
ADMIN_EMAIL=your-email@example.com

# OpenRouter (optional - for AI meal suggestions)
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Calendar (optional - for calendar sync)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
