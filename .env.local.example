# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin (optional - for initial setup)
ADMIN_EMAIL=your@email.com

# OpenRouter (AI meal suggestions)
OPENROUTER_API_KEY=sk-or-...

# Google Calendar Integration
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=https://your-domain.com/api/calendar/callback

# Push Notifications (VAPID)
# Generate with: npx tsx scripts/generate-vapid-keys.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:support@your-domain.com
